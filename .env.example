# StudyPilot Frontend Environment Variables
# Copy this file to .env and replace with your real Supabase project credentials.

# Supabase Project URL (found in Project Settings -> API)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Supabase Anonymous/Publishable Key (found in Project Settings -> API -> anon public)
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Phone OTP Authentication Feature Flag (true | false)
# Keep false unless a real SMS provider (Twilio, MessageBird, Vonage) is configured in Supabase.
VITE_ENABLE_PHONE_AUTH=false
